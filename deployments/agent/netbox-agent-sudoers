# /etc/sudoers.d/netbox-agent
# Allow the netbox-agent service account to manage NetBox-related systemd units
# and run privileged operations required by the conductor task executors.
# Generated by the NetBox Conductor agent installer — do not edit by hand.
# install.sh appends the NetBox lines (services, folder repair) unless --db-only.

# Systemd service management (as root)
netbox-agent ALL=(ALL) NOPASSWD: \
  /usr/bin/systemctl stop postgresql, \
  /usr/bin/systemctl restart patroni, \
  /usr/bin/systemctl stop redis, \
  /usr/bin/systemctl start redis, \
  /usr/bin/systemctl restart redis, \
  /usr/bin/systemctl stop redis-sentinel, \
  /usr/bin/systemctl start redis-sentinel, \
  /usr/bin/systemctl restart redis-sentinel, \
  /usr/bin/systemctl disable redis-sentinel, \
  /usr/bin/systemctl enable redis-sentinel, \
  /usr/bin/systemctl restart netbox-agent

# Database backup: run pg_dump, psql, pgbackrest, and pg_ctl as the postgres OS user
# so that peer authentication works without a password. The agent's own repo
# helper (`netbox-agent repo ...`) writes and deletes backup sync files as postgres,
# the owner of the backup storage folders.
netbox-agent ALL=(postgres) NOPASSWD: \
  /usr/bin/pg_dump, \
  /usr/bin/psql, \
  /bin/mkdir, \
  /usr/bin/pgbackrest, \
  /usr/local/bin/pg_ctl, \
  /usr/local/bin/netbox-agent

