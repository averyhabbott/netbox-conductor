[Unit]
Description=NetBox Conductor Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netbox-agent
Group=netbox-agent
EnvironmentFile=/etc/netbox-agent/netbox-agent.env
ExecStart=/usr/local/bin/netbox-agent
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=netbox-agent

# Harden the service
# Note: NoNewPrivileges is intentionally omitted — the agent needs to invoke
# sudo to manage systemd services (netbox, patroni, redis, etc.).
# ProtectSystem is intentionally omitted too: commands the agent starts via sudo
# inherit its read-only view, which blocks pgBackRest, pg_dump and restores from
# writing their repo, log and data dirs. Access is limited by the agent's groups
# and the sudoers file instead.
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
